@EndUserText.label: 'Travel Processor Scenario Service definition'
define service ZATS_VJ_SD_M_TRAVELPROJECTION {
  expose ZATS_VJ_M_TRAVEL_PROCESSOR    as Travel;
  expose ZATS_VJ_M_BOOKING_PROCESSOR   as Booking;
  expose ZATS_VJ_M_BOOKSUPPL_PROCESSOR as BookingSuppl;
  expose ZATS_VJ_TATTACH_PROCESSOR     as Attachment;
  expose /DMO/I_Agency                 as Agency;
  expose /DMO/I_Customer               as Customer;
  expose I_Currency                    as Currency;
  expose /DMO/I_Carrier                as Carrier;
  expose /DMO/I_Connection             as Connection;
  expose /DMO/I_Flight                 as Flight;
  expose /DMO/I_Supplement             as Supplement;
  expose /DMO/I_SupplementText         as SupplText;
  expose /DMO/I_Overall_Status_VH      as TravelStatus;
  expose /DMO/I_Booking_Status_VH      as BookStatus;
}