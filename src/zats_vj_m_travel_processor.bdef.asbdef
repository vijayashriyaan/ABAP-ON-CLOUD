projection implementation in class zbp_ats_vj_m_travel_APPROVER  unique;
strict ( 2 );

use collaborative draft;
//to make determine action work, expose side effects in the b projection
use side effects;

define behavior for ZATS_VJ_M_TRAVEL_PROCESSOR alias Travel
{
  use create(augment);
  use update;
  use delete;

   //expose our draft actions
  use action Edit;
  use action Prepare;
  use action Discard;
  use action Activate;
  use action Resume;
  use action Share;

  //use action validateCustomer;

  //use action copyTravel;

  //use association _Booking { create; }
   use association _Booking { create; with draft; }
}

define behavior for ZATS_VJ_M_BOOKING_PROCESSOR alias Booking
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _BookSuppl { create; with draft; }

}

define behavior for ZATS_VJ_M_BOOKSUPPL_PROCESSOR alias BookSuppl
{
  use update;
  use delete;

 // use association _Travel;
 // use association _Booking;

   use association _Travel { with draft; }
  use association _Booking { with draft; }

  }